{
  "name": "city-builder",
  "version": "0.1.0",
  "private": true,
  "description": "City-builder 3D original (Three.js + simulation en Web Worker)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/unit/*.test.ts",
    "assets": "tsx tools/pipeline.ts",
    "validate:assets": "tsx tools/validate-models.ts",
    "validate:visual": "node tests/e2e/validate-visual.mjs",
    "e2e": "node tests/e2e/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e && npm run e2e:gate",
    "e2e:gate": "node tests/e2e/gate-selftest.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
