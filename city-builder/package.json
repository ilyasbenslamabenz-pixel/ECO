{
  "name": "city-builder",
  "version": "0.1.0",
  "private": true,
  "description": "City-builder 3D original (Three.js + simulation en Web Worker)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/unit/*.test.ts tests/sim/*.test.ts tests/roads/*.test.ts tests/terrain/*.test.ts tests/vehicles/*.test.ts tests/construction/*.test.ts tests/integration/*.test.ts tests/plugins/*.test.ts tests/batiments/*.test.ts tests/circulation/*.test.ts tests/pietons/*.test.ts tests/chantiers/*.test.ts tests/props/*.test.ts tests/weather/*.test.ts tests/municipal/*.test.ts tests/save/*.test.ts tests/electricite/*.test.ts tests/dechets/*.test.ts tests/hubs/*.test.ts tests/eau/*.test.ts tests/zonage/*.test.ts",
    "assets": "tsx tools/pipeline.ts",
    "validate:assets": "tsx tools/validate-models.ts",
    "validate:visual": "node tests/e2e/validate-visual.mjs",
    "e2e": "node tests/e2e/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e && npm run e2e:gate",
    "e2e:gate": "node tests/e2e/gate-selftest.mjs",
    "test:assets": "tsx --test tests/buildings/*.test.ts tests/buildings-other/*.test.ts tests/transport-assets/*.test.ts",
    "transport:build": "tsx tools/transport/build.ts && tsx tools/transport/catalog.ts",
    "transport:showcase": "tsx tools/transport/showcase/run.ts",
    "hubs:captures": "node tests/hubs/captures.mjs",
    "test:all": "npm test && npm run test:assets",
    "buildings:residential": "tsx tools/buildings/residential/build.ts",
    "buildings:showcase": "tsx tools/buildings/showcase/run.ts",
    "buildings:other:showcase": "tsx tools/buildings/nonresidential/showcase/run.ts --sheet=planche_non_residentiel",
    "vehicles:build": "tsx tools/vehicles/build.ts",
    "vehicles:showcase": "tsx tools/vehicles/showcase/run.ts",
    "vehicles:demo": "tsx tests/vehicles/capture.ts",
    "roads:demo": "tsx tests/roads/capture.ts",
    "sim:demo": "node tests/sim/capture.mjs",
    "construction:demo": "node tests/construction/demo.mjs",
    "demo:env": "node src/render/terrain/demo/build-demo.mjs && node src/render/terrain/demo/capture.mjs",
    "assets:validate": "tsx tools/assets/validate.ts",
    "assets:showcase": "tsx tools/assets/showcase/run.ts --lods",
    "stress": "node tests/e2e/stress.mjs",
    "e2e:game": "node tests/e2e/gameplay.mjs",
    "e2e:play": "node tests/e2e/play.mjs",
    "e2e:mobile": "node tests/e2e/mobile-batiment.mjs",
    "e2e:signals": "node tests/e2e/signals.mjs",
    "e2e:routes": "node tests/e2e/road-tools.mjs",
    "captures": "node tests/e2e/captures.mjs",
    "circulation:bench": "tsx tests/circulation/bench.ts",
    "power:build": "tsx tools/power/build.ts",
    "e2e:electricite": "node tests/electricite/e2e.mjs",
    "waste:build": "tsx tools/waste/build.ts",
    "eau:models": "tsx tools/water-network/build.ts",
    "eau:captures": "node tests/eau/capture.mjs",
    "e2e:zonage": "node tests/zonage/e2e.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
