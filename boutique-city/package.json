{
  "name": "boutique-city",
  "version": "0.1.0",
  "private": true,
  "description": "Boutique City — jeu de gestion de commerces dans un quartier (Three.js)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
